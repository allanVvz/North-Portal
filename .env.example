# Application runtime ---------------------------------------------------------
# Public Supabase values. These are bundled for the browser and are NOT secrets.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_, expose to the browser, or log it.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI (local/operations only; do not add these to Vercel).
SUPABASE_PROJECT_REF=
# Optional when already authenticated with `npx supabase login`.
SUPABASE_ACCESS_TOKEN=
# Optional for interactive runs; required for unattended link/push when prompted.
SUPABASE_DB_PASSWORD=

# Sanitized demo users. Set only while running `npm run create:demo-users`.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_CLIENT_EMAIL=
DEMO_CLIENT_PASSWORD=

# Supabase Auth dashboard values (reference only; the app derives redirects from
# the current origin). Configure Site URL and Redirect URLs in Supabase Auth.
# Local example: http://localhost:3000 and http://localhost:3000/**
# Production example: https://YOUR-DOMAIN and https://YOUR-DOMAIN/**

# Meta (Facebook) OAuth — App em developers.facebook.com, produto "Facebook
# Login for Business". Registrar como Valid OAuth Redirect URI:
#   https://YOUR-DOMAIN/api/admin/integrations/meta/callback
#   http://localhost:3000/api/admin/integrations/meta/callback (dev local)
# Server-only — nunca prefixar com NEXT_PUBLIC_.
META_APP_ID=
META_APP_SECRET=

# Automações (relatório de anúncios semanal) — shared secret checked by
# app/api/admin/automations/run against the pg_cron/pg_net job's
# x-cron-secret header (supabase/migrations/20260821025707_automation_cron_daily.sql).
# Server-only. After deploying, also set the matching Postgres GUC once:
#   alter database postgres set app.cron_secret = 'the same value';
#   alter database postgres set app.automations_endpoint = 'https://YOUR-DOMAIN/api/admin/automations/run';
CRON_SECRET=

# Google Drive (service account) — automação "Criar pasta no Drive" do cadastro
# de cliente e preview de arquivos no admin (lib/googleDrive.ts).
# OPCIONAL: sem estas duas variáveis a automação fica desligada, o toggle aparece
# desabilitado no formulário e os links de pasta seguem editáveis à mão.
# Setup: criar uma service account no Google Cloud com a Drive API habilitada,
# gerar uma chave JSON, e compartilhar a pasta-raiz do Drive com o client_email
# da service account (permissão de Editor).
# Server-only — nunca prefixar com NEXT_PUBLIC_.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
