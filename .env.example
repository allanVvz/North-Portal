# Supabase project (cloud). Get these from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public anon / publishable key (safe for the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Auth is now session-based (Supabase Auth). NORTH_ADMIN_TOKEN is no longer used.
# For local dev pointing at the cloud project, copy this file to .env.local and fill in.
