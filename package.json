{
  "name": "north-client-portal",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "env:check": "node scripts/validate-env.mjs app",
    "env:check:cloud": "node scripts/validate-env.mjs cloud",
    "repo:check": "node scripts/check-repository.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "check:deploy": "npm run env:check && npm run repo:check && npm run verify",
    "supabase:link": "node scripts/supabase-cloud.mjs link",
    "db:migrate": "node scripts/supabase-cloud.mjs migrate",
    "db:seed": "node scripts/supabase-cloud.mjs seed",
    "create:demo-users": "node scripts/create-demo-users.mjs",
    "test:e2e": "playwright test",
    "update:client": "node scripts/update-client.mjs",
    "create:user": "node scripts/create-user.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "next": "15.5.7",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "recharts": "^3.9.2",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "eslint": "^9.30.0",
    "eslint-config-next": "15.5.7",
    "supabase": "^2.113.0",
    "typescript": "5.8.3",
    "vitest": "^4.1.9"
  }
}
